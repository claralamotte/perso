<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Salésienne de Paris - Carte de la saison 2026-2027</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --green:#00AB60; --mint:#DBF9F1; --amber:#F5B82E;
  --green-ink:#007A45; --amber-ink:#8A5E00;
  --deep:#0B3D2E; --ink:#123328; --muted:#6E8A7E;
  --card:rgba(255,255,255,.82); --cardline:rgba(11,61,46,.10);
  --radius:16px; --shadow:0 14px 40px rgba(11,61,46,.16);
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{font-family:'DM Sans',system-ui,sans-serif;color:var(--ink);overflow:hidden}
#map{position:absolute;inset:0;z-index:1;background:
  radial-gradient(120% 120% at 50% 30%, #FFFFFF 0%, var(--mint) 60%, #CDEEE4 100%)}
.leaflet-container{font-family:inherit;background:transparent}

/* Brand card */
.brand{position:absolute;top:16px;left:16px;z-index:1000;display:flex;align-items:center;gap:12px;
  background:var(--card);backdrop-filter:blur(12px);border:1px solid var(--cardline);
  border-radius:var(--radius);padding:12px 16px 12px 12px;box-shadow:var(--shadow);max-width:calc(100vw - 32px)}
.crest{width:42px;height:42px;border-radius:50%;background:var(--green);color:#fff;display:flex;align-items:center;
  justify-content:center;font-weight:700;font-size:15px;flex-shrink:0;box-shadow:inset 0 0 0 3px rgba(255,255,255,.35)}
.brand h1{font-size:15px;font-weight:700;color:var(--deep);line-height:1.15;white-space:nowrap}
.brand p{font-size:11px;color:var(--muted);font-weight:500;margin-top:2px}
.crest img{width:100%;height:100%;object-fit:contain;padding:3px}
.crest{overflow:hidden}
.rtag{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.04em;color:#fff;background:var(--green);padding:1px 7px;border-radius:999px;vertical-align:middle;margin-left:2px}

/* Controls */
.controls{position:absolute;top:16px;right:16px;z-index:1000;display:flex;flex-direction:column;gap:10px;align-items:flex-end}
.seg{display:inline-flex;background:var(--card);backdrop-filter:blur(12px);border:1px solid var(--cardline);
  border-radius:999px;padding:4px;box-shadow:var(--shadow)}
.seg button{border:none;background:transparent;font-family:inherit;font-size:12px;font-weight:600;color:var(--muted);
  padding:6px 14px;border-radius:999px;cursor:pointer;transition:all .18s;white-space:nowrap}
.seg button.on{background:var(--green);color:#fff}
.legend{display:flex;gap:14px;background:var(--card);backdrop-filter:blur(12px);border:1px solid var(--cardline);
  border-radius:999px;padding:8px 14px;box-shadow:var(--shadow)}
.legend span{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;color:var(--ink)}
.dot-l{width:11px;height:11px;border-radius:50%;flex-shrink:0}

/* Map labels */
.city,.cname{pointer-events:none}
.cdot{display:inline-block;width:4px;height:4px;border-radius:50%;background:#95A3AA;vertical-align:middle;margin-right:4px}
.cname{font-size:9.5px;font-weight:500;color:#849099;white-space:nowrap;vertical-align:middle}
.cdot-p{display:inline-block;width:8px;height:8px;border-radius:50%;background:#fff;border:2px solid var(--deep);vertical-align:middle;margin-right:5px}
.cname-p{font-size:13px;font-weight:600;color:var(--deep);letter-spacing:.02em;vertical-align:middle}
.pclabel{font-size:10px;font-weight:600;font-style:italic;color:rgba(0,150,84,.9);white-space:nowrap;letter-spacing:.03em}
.compass{position:absolute;bottom:56px;left:14px;z-index:1000;width:34px;height:34px;border-radius:50%;
  background:var(--card);backdrop-filter:blur(12px);border:1px solid var(--cardline);box-shadow:var(--shadow);
  display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--deep)}
.compass b{color:var(--green)}
.leaflet-control-scale-line{background:rgba(255,255,255,.7);border-color:var(--cardline);color:var(--ink);font-family:'DM Sans',sans-serif;border-radius:0 0 4px 4px}

/* Chips (markers): glass fill, coloured text, no border, dashed leader + dot */
.pin{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;cursor:pointer;
  filter:drop-shadow(0 5px 10px rgba(11,61,46,.18))}
.pin-home{height:78px;--c:#00AB60}
.pin-away{height:72px;--c:#F5B82E}
.chip{position:relative;border-radius:999px;padding:6px 13px;font-size:12px;font-weight:600;white-space:nowrap;
  line-height:1.05;backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);transition:transform .16s ease}
.chip .sub{display:block;font-size:9px;font-weight:500;letter-spacing:.02em;margin-top:3px;opacity:.92}
.chip .cdate{font-weight:500}
.chip .cadv{font-weight:700}
.chip-home{background:linear-gradient(rgba(0,171,96,.16),rgba(0,171,96,.16)),rgba(255,255,255,.58);color:var(--green-ink);text-align:center}
.chip-away{background:linear-gradient(rgba(245,184,46,.15),rgba(245,184,46,.15)),rgba(255,255,255,.82);color:#F5B82E;text-shadow:0 1px 1.5px rgba(11,61,46,.30)}
.lead{width:0;height:20px;border-left:1.6px dashed var(--c)}
.dot{width:9px;height:9px;border-radius:50%;background:var(--c);box-shadow:0 0 0 3px rgba(255,255,255,.78)}
.numdot{min-width:18px;height:17px;border-radius:999px;background:linear-gradient(rgba(245,184,46,.22),rgba(245,184,46,.22)),rgba(255,255,255,.9);color:#F5B82E;font-size:9px;font-weight:700;
  display:flex;align-items:center;justify-content:center;padding:0 5px;box-shadow:0 0 0 2px rgba(255,255,255,.9);text-shadow:0 1px 1px rgba(11,61,46,.28)}
.pin:hover .chip{transform:translateY(-2px)}
.pin.next .chip::after{content:"prochain match";position:absolute;left:50%;top:0;transform:translate(-50%,-155%);
  font-size:8px;font-weight:700;color:#fff;background:var(--deep);padding:2px 8px;border-radius:999px;letter-spacing:.04em;white-space:nowrap}
.pin.next .chip{animation:pulseN 1.8s ease-in-out infinite}
.pin-home.next .chip{background:var(--green);color:#fff;text-shadow:none}
.pin-away.next .chip{background:#F5B82E;color:#fff;text-shadow:0 1px 2px rgba(90,60,0,.55)}
@keyframes pulseN{0%,100%{box-shadow:0 0 0 0 rgba(11,61,46,.4)}50%{box-shadow:0 0 0 9px rgba(11,61,46,0)}}
@media(prefers-reduced-motion:reduce){.pin.next .chip{animation:none}}

/* Panel */
.panel{position:absolute;top:0;right:0;height:100%;width:380px;max-width:90vw;z-index:1100;
  background:rgba(255,255,255,.95);backdrop-filter:blur(16px);border-left:1px solid var(--cardline);
  box-shadow:-12px 0 40px rgba(11,61,46,.14);transform:translateX(100%);
  transition:transform .28s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;overflow:hidden}
.panel.open{transform:translateX(0)}
.panel-head{padding:20px 22px 14px;position:relative;flex-shrink:0}
.panel-body{padding:0 22px 26px;overflow-y:auto}
.px{position:absolute;top:16px;right:16px;width:30px;height:30px;border-radius:50%;border:1px solid var(--cardline);
  background:#fff;color:var(--muted);cursor:pointer;font-size:13px;display:flex;align-items:center;justify-content:center}
.tag{display:inline-block;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:999px}
.tag-home{background:var(--green);color:#fff}
.tag-away{background:var(--amber);color:#4a3505}
.oppo{display:flex;align-items:center;gap:14px;margin:14px 0 6px}
.badge{width:52px;height:52px;border-radius:50%;background:var(--green);color:#fff;font-weight:700;font-size:17px;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
.badge img{width:100%;height:100%;object-fit:contain;background:#fff}
.oppo h2{font-size:19px;font-weight:700;color:var(--deep);line-height:1.15}
.oppo .when{font-size:12px;color:var(--muted);font-weight:500;margin-top:3px;text-transform:capitalize}
.score{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:16px 0 4px;padding:14px 16px;border-radius:14px;background:var(--mint)}
.score .n{font-size:26px;font-weight:700;color:var(--deep)}
.score .lab{font-size:11px;font-weight:600;color:var(--muted)}
.score.win{background:rgba(0,171,96,.14)} .score.win .n{color:var(--green)}
.score.loss{background:rgba(11,61,46,.06)} .score.loss .n{color:var(--muted)}
.score.draw{background:rgba(245,184,46,.20)} .score.draw .n{color:#a9760a}
.score.todo{flex-direction:column;align-items:flex-start;gap:2px;background:rgba(11,61,46,.045)}
.score.todo .lab{font-size:13px;font-weight:700;color:var(--ink)}
.score.todo .sub2{font-size:11px;color:var(--muted);font-weight:500}
.res{width:100%;flex-basis:100%;font-size:12px;font-weight:700;margin-top:2px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.field{background:#fff;border:1px solid var(--cardline);border-radius:12px;padding:10px 12px}
.field.wide{grid-column:1 / -1}
.field .k{font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.field .v{font-size:13px;font-weight:600;color:var(--ink);margin-top:4px}
.field .v.todo{color:#b98a12}
.field .v .est{font-weight:500;color:var(--muted);font-size:11px}
.field .v a{color:var(--green);font-weight:700;text-decoration:none;white-space:nowrap}
.field .v a:hover{text-decoration:underline}
.travel{margin-top:14px;background:#fff;border:1px solid var(--cardline);border-radius:14px;padding:14px 14px 12px}
.travel-h{font-size:12px;font-weight:700;color:var(--deep)}
.travel-h span{display:block;font-size:10px;font-weight:500;color:var(--muted);margin-top:2px}
.modes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.mode{display:flex;flex-direction:column;align-items:center;gap:7px;text-decoration:none;
  background:var(--mint);border-radius:12px;padding:12px 6px;transition:transform .15s ease, box-shadow .15s ease}
.mode:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(0,171,96,.18)}
.mode-ic{width:34px;height:34px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;color:var(--green)}
.mode-ic svg{width:18px;height:18px}
.mode-lab{font-size:10.5px;font-weight:600;color:var(--ink)}
.mode-val{font-size:11px;font-weight:700;color:var(--green)}
.travel-note{font-size:10px;color:var(--muted);margin-top:10px;font-weight:500;line-height:1.4}
.section-lbl{font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:18px 0 4px}
.cal-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--cardline);cursor:pointer}
.cal-row:last-child{border-bottom:none}
.cal-date{width:52px;flex-shrink:0;text-align:center}
.cal-date .d{font-size:16px;font-weight:700;color:var(--deep);line-height:1}
.cal-date .m{font-size:9px;font-weight:600;text-transform:uppercase;color:var(--muted);letter-spacing:.06em}
.cal-oppo{flex:1;min-width:0}
.cal-oppo .nm{font-size:13px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cal-oppo .hr{font-size:11px;color:var(--muted)}
.cal-res{font-size:12px;font-weight:700;padding:3px 9px;border-radius:999px;background:var(--mint);color:var(--green);flex-shrink:0}
.loc{font-size:9px;font-weight:700;padding:1px 7px;border-radius:999px;margin-right:2px}
.loc-d{background:rgba(0,171,96,.14);color:var(--green)}
.loc-e{background:rgba(245,184,46,.16);color:#F5B82E;text-shadow:0 1px 1px rgba(11,61,46,.22)}
.cal-res.todo{background:rgba(11,61,46,.05);color:var(--muted);font-weight:600}
.hint{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);z-index:1000;background:var(--card);
  backdrop-filter:blur(12px);border:1px solid var(--cardline);border-radius:999px;padding:8px 16px;
  font-size:11.5px;font-weight:600;color:var(--ink);box-shadow:var(--shadow)}

@media(max-width:700px){
  .brand h1{font-size:13px;white-space:normal}
  .controls{top:auto;bottom:14px;right:14px;left:14px;flex-direction:row;justify-content:center;flex-wrap:wrap}
  .legend{display:none}.hint{display:none}
  .panel{top:auto;bottom:0;left:0;right:0;width:100%;max-width:100%;height:auto;max-height:76vh;
    border-left:none;border-top:1px solid var(--cardline);border-radius:20px 20px 0 0;
    transform:translateY(100%);box-shadow:0 -12px 40px rgba(11,61,46,.18)}
  .panel.open{transform:translateY(0)}
}
</style>
</head>
