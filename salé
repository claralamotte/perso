const MOIS=["jan","fév","mar","avr","mai","juin","juil","aoû","sep","oct","nov","déc"];
function parseDate(s){const p=(s||"").split("/");if(p.length!==3)return null;return new Date(+p[2],+p[1]-1,+p[0]);}
function chipDate(s){const p=(s||"").split("/");if(p.length!==3)return s;return (+p[0])+" "+MOIS[(+p[1])-1];}
function longDate(s){const d=parseDate(s);if(!d)return s;return d.toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});}
function fmtH(h){return (h||"").replace(":","h");}
function rdv(h){const p=(h||"").split(":");if(p.length<2)return "-";let t=(+p[0])*60+(+p[1])-90;if(t<0)t+=1440;return Math.floor(t/60)+"h"+String(t%60).padStart(2,"0");}
function initials(n){const w=(n||"").replace(/[^A-Za-zÀ-ÿ0-9 ]/g," ").trim().split(/\s+/).filter(x=>x&&isNaN(x));return ((w[0]||"")[0]||"?").toUpperCase()+((w[1]||"")[0]||"").toUpperCase();}
function played(m){return m.sS!==""&&m.sS!=null&&m.sA!==""&&m.sA!=null;}
function badgeHTML(m){if(m.logo)return '<div class="badge"><img src="'+m.logo+'" onerror="this.parentNode.textContent=\''+initials(m.adv)+'\'"></div>';return '<div class="badge">'+initials(m.adv)+'</div>';}
function mapsLink(m,mode){return "https://www.google.com/maps/dir/?api=1&origin="+encodeURIComponent(HOME.addr)+"&destination="+m.lat+","+m.lng+"&travelmode="+(mode||"driving");}
function distKm(m){const R=6371,rad=x=>x*Math.PI/180,dLat=rad(m.lat-HOME.lat),dLng=rad(m.lng-HOME.lng);
  const a=Math.sin(dLat/2)**2+Math.cos(rad(HOME.lat))*Math.cos(rad(m.lat))*Math.sin(dLng/2)**2;return 2*R*Math.asin(Math.sqrt(a));}
function fmtDur(min){if(min<60)return min+" min";const h=Math.floor(min/60),r=min%60;return h+"h"+(r?String(r).padStart(2,"0"):"00");}
function bikeEst(m){const min=Math.max(5,Math.round(distKm(m)*1.25/15*60/5)*5);return "env. "+fmtDur(min);}
function metroEst(m){const min=Math.round((20+distKm(m)*1.25/25*60)/5)*5;return "env. "+fmtDur(min);}
const ICON={
 car:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l1.5-4.5A2 2 0 0 1 8.4 6h7.2a2 2 0 0 1 1.9 1.5L19 12"/><path d="M4 12h16v4a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1H7a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><circle cx="7.5" cy="14.5" r="1"/><circle cx="16.5" cy="14.5" r="1"/></svg>',
 bike:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="16" r="3.2"/><circle cx="18" cy="16" r="3.2"/><path d="M6 16l3.5-6h5"/><path d="M9.5 10L12 16h6"/><path d="M13.5 7h2.5"/></svg>',
 metro:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="12" rx="3"/><path d="M6 10h12"/><circle cx="9" cy="13" r="0.6" fill="currentColor"/><circle cx="15" cy="13" r="0.6" fill="currentColor"/><path d="M8 16l-1.5 3M16 16l1.5 3"/></svg>'
};
function modeCard(m,mode,icon,lab,val){return '<a class="mode" href="'+mapsLink(m,mode)+'" target="_blank" rel="noopener"><span class="mode-ic">'+icon+'</span><span class="mode-lab">'+lab+'</span><span class="mode-val">'+val+'</span></a>';}
function buildTravel(m){return '<div class="travel"><div class="travel-h">Comment y aller <span>depuis la Porte d\'Asnières</span></div>'+
  '<div class="modes">'+
   modeCard(m,'transit',ICON.metro,'Métro / RER',metroEst(m))+
   modeCard(m,'bicycling',ICON.bike,'Vélo',bikeEst(m))+
   modeCard(m,'driving',ICON.car,'Voiture',m.trajet||'Voir')+
  '</div><div class="travel-note">Estimations approximatives (hors trafic). Temps réel, horaires et itinéraire exact en cliquant.</div></div>';}

let map,layer,currentFilter="all",nextKey=null;

/* live sheet loader */
function mapRow(r){const g=(k)=>{for(const key in r){if(key.trim().toLowerCase()===k)return (r[key]||"").toString().trim();}return "";};
  return {j:g("journee")||g("journée"),date:g("date"),heure:g("heure"),lieu:g("lieu"),adv:g("adversaire"),ville:g("ville"),
    stade:g("stade / adresse")||g("stade"),lat:parseFloat((g("latitude")||"").replace(",",".")),lng:parseFloat((g("longitude")||"").replace(",",".")),
    logo:g("logo (url)")||g("logo"),classt:g("classement n-1"),division:g("division / poule")||g("division"),
    sS:g("score salesienne")||g("score salésienne"),sA:g("score adversaire"),trajet:g("trajet")||"",notes:g("notes")};}
function loadData(cb){if(!SHEET_CSV_URL){cb();return;}
  Papa.parse(SHEET_CSV_URL,{download:true,header:true,skipEmptyLines:true,
    complete:function(res){try{const rows=res.data.map(mapRow).filter(x=>x.date&&!isNaN(x.lat)&&!isNaN(x.lng));if(rows.length)MATCHES=rows;}catch(e){console.warn(e);}cb();},
    error:function(e){console.warn(e);cb();}});}

function computeNext(){const now=new Date();now.setHours(0,0,0,0);let best=null;
  MATCHES.forEach(m=>{const d=parseDate(m.date);if(d&&d>=now&&(!best||d<parseDate(best.date)))best=m;});nextKey=best?best.j:null;}

/* schematic Paris (lines only) */
function smooth(pts,closed,seg){
  seg=seg||14;const n=pts.length,res=[];
  const get=i=>closed?pts[((i%n)+n)%n]:pts[Math.max(0,Math.min(n-1,i))];
  const last=closed?n:n-1;
  for(let i=0;i<last;i++){const p0=get(i-1),p1=get(i),p2=get(i+1),p3=get(i+2);
    for(let t=0;t<seg;t++){const s=t/seg,s2=s*s,s3=s2*s;
      res.push([
        0.5*((2*p1[0])+(-p0[0]+p2[0])*s+(2*p0[0]-5*p1[0]+4*p2[0]-p3[0])*s2+(-p0[0]+3*p1[0]-3*p2[0]+p3[0])*s3),
        0.5*((2*p1[1])+(-p0[1]+p2[1])*s+(2*p0[1]-5*p1[1]+4*p2[1]-p3[1])*s2+(-p0[1]+3*p1[1]-3*p2[1]+p3[1])*s3)
      ]);}}
  res.push(closed?res[0]:pts[n-1]);return res;
}
function label(lat,lng,cls,txt,ax){L.marker([lat,lng],{icon:L.divIcon({className:'',html:'<span class="'+cls+'">'+txt+'</span>',iconSize:[130,16],iconAnchor:[ax||3,8]}),interactive:false,keyboard:false}).addTo(map);}

function drawIDF(){
  // Contour Île-de-France (arrondi)
  const idf=[[49.18,1.95],[49.10,2.30],[49.10,2.75],[49.02,3.05],[48.95,3.30],[48.78,3.55],[48.58,3.55],
    [48.40,3.35],[48.22,3.15],[48.10,2.75],[48.13,2.35],[48.28,2.05],[48.50,1.72],[48.75,1.50],
    [48.95,1.58],[49.10,1.75],[49.18,1.95]];
  L.polygon(smooth(idf,true),{color:'#8FA0A8',weight:1.6,opacity:.85,fill:true,fillColor:'#ffffff',fillOpacity:.55,lineJoin:'round'}).addTo(map);

  // Grands axes routiers (arrondis)
  const road={color:'#D97A7A',weight:1.3,opacity:.45,lineJoin:'round',lineCap:'round'};
  const roads=[
    [[48.88,2.28],[48.95,2.20],[49.036,2.078],[48.99,1.717]],
    [[48.90,2.35],[48.936,2.357],[48.997,2.383],[49.10,2.45]],
    [[48.86,2.40],[48.848,2.549],[48.90,2.70],[48.960,2.879],[48.815,3.083]],
    [[48.85,2.45],[48.80,2.90],[48.560,3.298]],
    [[48.80,2.36],[48.75,2.40],[48.629,2.446],[48.541,2.660],[48.404,2.702],[48.267,2.699]],
    [[48.78,2.30],[48.65,2.25],[48.50,2.20],[48.434,2.161]],
    [[48.85,2.25],[48.804,2.130],[48.644,1.830]],
    [[48.87,2.20],[48.90,2.00],[48.990,1.717]]
  ];
  roads.forEach(r=>L.polyline(smooth(r,false),road).addTo(map));

  // Anneau Paris intra-muros (périphérique)
  const paris=[[48.9015,2.3595],[48.8975,2.3870],[48.8645,2.4130],[48.8340,2.4150],[48.8175,2.3560],
    [48.8270,2.2980],[48.8420,2.2560],[48.8720,2.2680],[48.8880,2.2990],[48.8960,2.3130],[48.9000,2.3350]];
  L.polyline(smooth(paris,true),{color:'#00AB60',weight:1.6,opacity:.7,lineJoin:'round'}).addTo(map);
  // Anneau Petite couronne (75+92+93+94)
  const pc=[[48.96,2.30],[48.97,2.45],[48.95,2.55],[48.90,2.60],[48.83,2.60],[48.75,2.55],[48.71,2.45],
    [48.71,2.32],[48.74,2.22],[48.82,2.13],[48.90,2.13],[48.95,2.20]];
  L.polyline(smooth(pc,true),{color:'#00AB60',weight:1.5,opacity:.55,dashArray:'6 6',lineJoin:'round'}).addTo(map);
  label(48.695,2.355,'pclabel','Petite couronne',55);

  // Villes repères (Île-de-France)
  const cities=[
    ["Sarcelles",48.997,2.383],
    ["Créteil",48.790,2.455],["Évry",48.629,2.446],["Melun",48.541,2.660],
    ["Meaux",48.960,2.879],["Coulommiers",48.815,3.083],["Provins",48.560,3.298],["Fontainebleau",48.404,2.702],
    ["Nemours",48.267,2.699],["Étampes",48.434,2.161],["Rambouillet",48.644,1.830],["Mantes-la-Jolie",48.990,1.717]
  ];
  cities.forEach(c=>label(c[1],c[2],'cname','<span class="cdot"></span>'+c[0],3));
  L.marker([48.8566,2.3522],{icon:L.divIcon({className:'',html:'<span class="cdot-p"></span><span class="cname-p">Paris</span>',iconSize:[70,16],iconAnchor:[4,8]}),interactive:false,keyboard:false}).addTo(map);
}

function build(){
  if(layer)layer.remove();
  layer=L.layerGroup().addTo(map);
  const bounds=[];
  const homeMatches=MATCHES.filter(m=>m.lieu==="Domicile").sort((a,b)=>parseDate(a.date)-parseDate(b.date));
  if(currentFilter!=="Extérieur" && homeMatches.length){
    const isNext=homeMatches.some(m=>String(m.j)===String(nextKey));
    const html='<div class="pin pin-home'+(isNext?' next':'')+'"><div class="chip chip-home">Porte d\'Asnières<span class="sub">'+homeMatches.length+' matchs</span></div><div class="lead"></div><div class="dot"></div></div>';
    L.marker([HOME.lat,HOME.lng],{icon:L.divIcon({className:'',html:html,iconSize:[172,78],iconAnchor:[86,78]}),zIndexOffset:1000}).addTo(layer).on('click',showHome);
    bounds.push([HOME.lat,HOME.lng]);
  }
  MATCHES.filter(m=>m.lieu==="Extérieur").forEach(m=>{
    if(currentFilter==="Domicile")return;
    const isNext=String(m.j)===String(nextKey);
    const sc=played(m)?' · '+m.sS+'-'+m.sA:'';
    const html='<div class="pin pin-away'+(isNext?' next':'')+'"><div class="chip chip-away"><span class="cdate">'+chipDate(m.date)+sc+'</span><span class="sub cadv">'+m.adv+'</span></div><div class="lead"></div><div class="numdot">#'+m.j+'</div></div>';
    L.marker([m.lat,m.lng],{icon:L.divIcon({className:'',html:html,iconSize:[150,72],iconAnchor:[75,72]})}).addTo(layer).on('click',()=>showMatch(m));
    bounds.push([m.lat,m.lng]);
  });
  if(bounds.length)map.fitBounds(bounds,{padding:[80,80],maxZoom:12.5});
}

function openPanel(){document.getElementById('panel').classList.add('open');}
function closePanel(){document.getElementById('panel').classList.remove('open');}

function scoreBlock(m){
  if(!played(m))return '<div class="score todo"><div class="lab">Score final à venir</div><div class="sub2">il s\'affichera ici une fois le score saisi</div></div>';
  const s=+m.sS,a=+m.sA,cls=s>a?'win':(s<a?'loss':'draw'),lab=s>a?'Victoire':(s<a?'Défaite':'Match nul');
  return '<div class="score '+cls+'"><div class="n">'+m.sS+'</div><div class="lab">Salésienne</div>'+
    '<div class="n" style="margin-left:auto">'+m.sA+'</div><div class="lab">'+m.adv+'</div>'+
    '<div class="res">'+lab+'</div></div>';
}
function field(k,v,todo){return '<div class="field"><div class="k">'+k+'</div><div class="v'+(todo?' todo':'')+'">'+v+'</div></div>';}

function showMatch(m){
  const isHome=m.lieu==="Domicile";
  const tag=isHome?'<span class="tag tag-home">Domicile</span>':'<span class="tag tag-away">Déplacement</span>';
  document.getElementById('panel-head').innerHTML=tag+
    '<div class="oppo">'+badgeHTML(m)+'<div><h2>'+m.adv+'</h2><div class="when">'+longDate(m.date)+' · '+fmtH(m.heure)+'</div></div></div>';
  let body=scoreBlock(m);
  body+='<div class="grid2">'+
    field("Coup d'envoi",fmtH(m.heure),false)+
    field("Heure de RDV",rdv(m.heure)+" (1h30 avant)",false)+
    field("Lieu",m.ville,false)+
    field("Stade",m.stade||(isHome?HOME.stade:'à préciser'),!m.stade&&!isHome)+
  '</div>';
  if(!isHome){
    body+=buildTravel(m);
  }
  body+='<div class="grid2">'+
    field("Classement N-1",m.classt||'à renseigner',!m.classt)+
    field("Division",m.division||'à renseigner',!m.division)+
  '</div>';
  document.getElementById('panel-body').innerHTML=body;
  openPanel();
}

function showSeason(){
  const list=MATCHES.slice().sort((a,b)=>parseDate(a.date)-parseDate(b.date));
  document.getElementById('panel-head').innerHTML='<span class="tag tag-home">Saison 2026 - 2027 · R3</span>'+
    '<div class="oppo"><div class="badge" style="background:var(--green)">SP</div>'+
    '<div><h2>Calendrier complet</h2><div class="when" style="text-transform:none">'+list.length+' matchs · aller / retour</div></div></div>';
  let body='';
  list.forEach(m=>{const p=(m.date||"").split("/");
    const dom=m.lieu==="Domicile";
    const loc='<span class="loc '+(dom?'loc-d':'loc-e')+'">'+(dom?'Domicile':'Extérieur')+'</span>';
    const res=played(m)?'<span class="cal-res">'+m.sS+' - '+m.sA+'</span>':'<span class="cal-res todo">à venir</span>';
    body+='<div class="cal-row" data-j="'+m.j+'"><div class="cal-date"><div class="d">'+p[0]+'</div><div class="m">'+MOIS[(+p[1])-1]+'</div></div>'+
      '<div class="cal-oppo"><div class="nm">Match '+m.j+' · '+m.adv+'</div><div class="hr">'+loc+' · '+fmtH(m.heure)+'</div></div>'+res+'</div>';});
  document.getElementById('panel-body').innerHTML=body;
  document.getElementById('panel-body').querySelectorAll('.cal-row').forEach(row=>{
    row.addEventListener('click',()=>{const m=MATCHES.find(x=>String(x.j)===row.dataset.j);if(m)showMatch(m);});});
  openPanel();
}

function showHome(){
  const list=MATCHES.filter(m=>m.lieu==="Domicile").sort((a,b)=>parseDate(a.date)-parseDate(b.date));
  document.getElementById('panel-head').innerHTML='<span class="tag tag-home">Stade à domicile</span>'+
    '<div class="oppo"><div class="badge" style="background:var(--green)">SP</div>'+
    '<div><h2>Porte d\'Asnières</h2><div class="when" style="text-transform:none">'+HOME.stade+', '+HOME.ville+'</div></div></div>';
  let body='<div class="section-lbl">Calendrier à domicile · '+list.length+' matchs</div>';
  list.forEach(m=>{const p=(m.date||"").split("/");
    const res=played(m)?'<span class="cal-res">'+m.sS+' - '+m.sA+'</span>':'<span class="cal-res todo">à venir</span>';
    body+='<div class="cal-row" data-j="'+m.j+'"><div class="cal-date"><div class="d">'+p[0]+'</div><div class="m">'+MOIS[(+p[1])-1]+'</div></div>'+
      '<div class="cal-oppo"><div class="nm">'+m.adv+'</div><div class="hr">'+fmtH(m.heure)+' · RDV '+rdv(m.heure)+'</div></div>'+res+'</div>';});
  document.getElementById('panel-body').innerHTML=body;
  document.getElementById('panel-body').querySelectorAll('.cal-row').forEach(row=>{
    row.addEventListener('click',()=>{const m=MATCHES.find(x=>String(x.j)===row.dataset.j);if(m)showMatch(m);});});
  openPanel();
}

function init(){
  map=L.map('map',{zoomControl:false,attributionControl:false}).setView([48.86,2.32],11);
  L.control.zoom({position:'bottomright'}).addTo(map);
  L.control.scale({metric:true,imperial:false,position:'bottomleft'}).addTo(map);
  drawIDF();
  computeNext();
  build();
  document.getElementById('seg').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
    document.querySelectorAll('#seg button').forEach(x=>x.classList.remove('on'));b.classList.add('on');currentFilter=b.dataset.f;build();});
}
loadData(init);
</script>
